{
  "name": "linear-lens",
  "displayName": "Linear Lens",
  "description": "Make Linear issue IDs like ENG-123 clickable, hoverable, and useful inside VS Code.",
  "version": "0.1.0",
  "publisher": "linear-lens",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Visualization"
  ],
  "keywords": [
    "linear",
    "issue",
    "tracker",
    "todo",
    "links"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "linearLens.configureWorkspace",
        "title": "Configure Workspace Slug",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.openIssue",
        "title": "Open Issue…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.copyIssueLink",
        "title": "Copy Issue Link…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.refreshCache",
        "title": "Refresh Issue Cache",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.openCurrentBranchIssue",
        "title": "Open Current Branch Issue",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.signIn",
        "title": "Sign in to Linear",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.signOut",
        "title": "Sign out of Linear",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.showAuthStatus",
        "title": "Show Authentication Status",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.setApiKey",
        "title": "Set Personal API Key",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.clearApiKey",
        "title": "Clear Personal API Key",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.searchIssues",
        "title": "Go to Linear Issue…",
        "category": "Linear Lens",
        "icon": "$(search)"
      },
      {
        "command": "linearLens.refreshViews",
        "title": "Refresh Linear Views",
        "category": "Linear Lens",
        "icon": "$(refresh)"
      },
      {
        "command": "linearLens.jumpToNextReference",
        "title": "Jump to Next Reference",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.jumpToPreviousReference",
        "title": "Jump to Previous Reference",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.revealInLinearView",
        "title": "Reveal in Linear View",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.copyIssueId",
        "title": "Copy Issue ID",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.revealFileRef",
        "title": "Reveal File Reference",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.checkoutBranch",
        "title": "Checkout Issue Branch",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.openBranchDiff",
        "title": "Open Issue Branch Diff",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.openInAgent",
        "title": "Open in Coding Agent",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.openTicket",
        "title": "Open Issue Detail",
        "category": "Linear Lens",
        "icon": "$(preview)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "linearLens",
          "title": "Linear Lens",
          "icon": "media/linear.svg"
        }
      ]
    },
    "views": {
      "linearLens": [
        {
          "id": "linearLens.viewFile",
          "name": "Issues in This File"
        },
        {
          "id": "linearLens.viewMine",
          "name": "My Issues"
        },
        {
          "id": "linearLens.viewRecent",
          "name": "Assigned / Recent"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "linearLens.revealFileRef",
          "when": "false"
        },
        {
          "command": "linearLens.checkoutBranch",
          "when": "false"
        },
        {
          "command": "linearLens.openBranchDiff",
          "when": "false"
        },
        {
          "command": "linearLens.openInAgent",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "linearLens.refreshViews",
          "when": "view == linearLens.viewFile || view == linearLens.viewMine || view == linearLens.viewRecent",
          "group": "navigation"
        },
        {
          "command": "linearLens.searchIssues",
          "when": "view == linearLens.viewMine || view == linearLens.viewRecent",
          "group": "navigation"
        },
        {
          "command": "linearLens.signIn",
          "when": "(view == linearLens.viewMine || view == linearLens.viewRecent) && !linearLens.authed",
          "group": "1_auth"
        },
        {
          "command": "linearLens.signOut",
          "when": "(view == linearLens.viewMine || view == linearLens.viewRecent) && linearLens.authed",
          "group": "1_auth"
        }
      ],
      "view/item/context": [
        {
          "command": "linearLens.openTicket",
          "when": "viewItem == linearIssue",
          "group": "inline"
        },
        {
          "command": "linearLens.openTicket",
          "when": "viewItem == linearIssue",
          "group": "1_open@1"
        },
        {
          "command": "linearLens.openIssue",
          "when": "viewItem == linearIssue",
          "group": "1_open@2"
        },
        {
          "command": "linearLens.copyIssueLink",
          "when": "viewItem == linearIssue",
          "group": "1_open@3"
        },
        {
          "command": "linearLens.copyIssueId",
          "when": "viewItem == linearIssue",
          "group": "1_open@4"
        },
        {
          "command": "linearLens.checkoutBranch",
          "when": "viewItem == linearIssue",
          "group": "2_git@1"
        },
        {
          "command": "linearLens.openInAgent",
          "when": "viewItem == linearIssue",
          "group": "2_git@2"
        }
      ],
      "editor/context": [
        {
          "command": "linearLens.openTicket",
          "when": "editorTextFocus && linearLens.refUnderCursor",
          "group": "linearLens@1"
        },
        {
          "command": "linearLens.openIssue",
          "when": "editorTextFocus && linearLens.refUnderCursor",
          "group": "linearLens@2"
        },
        {
          "command": "linearLens.copyIssueId",
          "when": "editorTextFocus && linearLens.refUnderCursor",
          "group": "linearLens@3"
        },
        {
          "command": "linearLens.revealInLinearView",
          "when": "editorTextFocus && linearLens.refUnderCursor",
          "group": "linearLens@4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "linearLens.viewMine",
        "contents": "Sign in to Linear to see issues assigned to you.\n[Sign in to Linear](command:linearLens.signIn)\nOr [set a personal API key](command:linearLens.setApiKey).",
        "when": "!linearLens.authed"
      },
      {
        "view": "linearLens.viewRecent",
        "contents": "Sign in to Linear to see recent issues.\n[Sign in to Linear](command:linearLens.signIn)",
        "when": "!linearLens.authed"
      },
      {
        "view": "linearLens.viewFile",
        "contents": "No Linear references found in the active file.\nOpen a file that mentions issues like ENG-123, or [configure your workspace slug](command:linearLens.configureWorkspace)."
      }
    ],
    "keybindings": [
      {
        "command": "linearLens.openIssue",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "linearLens.searchIssues",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "linearLens.jumpToNextReference",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]",
        "when": "editorTextFocus && linearLens.hasRefs"
      },
      {
        "command": "linearLens.jumpToPreviousReference",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+[",
        "when": "editorTextFocus && linearLens.hasRefs"
      }
    ],
    "configuration": {
      "title": "Linear Lens",
      "properties": {
        "linearLens.workspaceSlug": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your Linear workspace slug, used to build issue URLs like `https://linear.app/<slug>/issue/ENG-123`. Find it in your Linear URL."
        },
        "linearLens.teamKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Optional allowlist of team keys to recognize (e.g. `[\"ENG\", \"DESIGN\"]`). When empty, any `ABC-123`-shaped token (2–7 letters) is treated as an issue ID."
        },
        "linearLens.markers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "TODO",
            "FIXME",
            "BUG",
            "HACK"
          ],
          "markdownDescription": "Actionable marker keywords. A reference on a line containing one of these (or an unchecked `- [ ]` task) is treated as actionable and can appear in the Problems panel. Matched case-insensitively with word boundaries."
        },
        "linearLens.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Surface actionable, marker-bound Linear references in the Problems panel. Raw references in prose are never reported."
        },
        "linearLens.diagnostics.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "information",
          "description": "Severity used for marker-bound Linear references in the Problems panel."
        },
        "linearLens.links.enable": {
          "type": "boolean",
          "default": true,
          "description": "Turn recognized issue references into clickable document links."
        },
        "linearLens.hover.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show hover cards for issue references."
        },
        "linearLens.decorations.enable": {
          "type": "boolean",
          "default": true,
          "description": "Visibly highlight recognized issue references in the editor."
        },
        "linearLens.statusBar.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar item for the Linear issue detected in the current git branch."
        },
        "linearLens.api.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Fetch live issue metadata (title, status, assignee, priority, project) for richer hovers when signed in or a personal API key is set. Acts as a master kill-switch: when off, hovers stay basic even when authenticated."
        },
        "linearLens.cache.ttlSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "How long (in seconds) to cache fetched issue metadata before refetching."
        },
        "linearLens.inlineStatus.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show a small colored status indicator next to each issue reference, reflecting the live workflow state. Requires sign-in / a personal API key."
        },
        "linearLens.inlineStatus.style": {
          "type": "string",
          "enum": [
            "dot",
            "pill"
          ],
          "default": "dot",
          "description": "Inline status style: a colored dot or a labeled state pill."
        },
        "linearLens.views.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show the Linear Activity Bar views (issues in this file, my issues, assigned / recent)."
        },
        "linearLens.views.recent.limit": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 100,
          "description": "How many issues to load in the My Issues / Assigned / Recent and search views."
        },
        "linearLens.agent.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional command id invoked by **Open in Coding Agent**. Leave empty to auto-detect a Cursor / VS Code agent command."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
