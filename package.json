{
  "name": "linear-lens",
  "displayName": "Linear Lens",
  "description": "Make Linear issue IDs like ENG-123 clickable, hoverable, and useful inside VS Code.",
  "version": "0.1.0",
  "publisher": "linear-lens",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Visualization"
  ],
  "keywords": [
    "linear",
    "issue",
    "tracker",
    "todo",
    "links"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "linearLens.configureWorkspace",
        "title": "Configure Workspace Slug",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.openIssue",
        "title": "Open Issue…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.copyIssueLink",
        "title": "Copy Issue Link…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.refreshCache",
        "title": "Refresh Issue Cache",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.openCurrentBranchIssue",
        "title": "Open Current Branch Issue",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.signIn",
        "title": "Sign in to Linear",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.signOut",
        "title": "Sign out of Linear",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.showAuthStatus",
        "title": "Show Authentication Status",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.setApiKey",
        "title": "Set Personal API Key",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.clearApiKey",
        "title": "Clear Personal API Key",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.searchIssues",
        "title": "Go to Linear Issue…",
        "category": "Linear Lens",
        "icon": "$(search)"
      },
      {
        "command": "linearLens.refreshViews",
        "title": "Refresh Linear Views",
        "category": "Linear Lens",
        "icon": "$(refresh)"
      },
      {
        "command": "linearLens.refreshTeams",
        "title": "Refresh Teams & Cycle",
        "category": "Linear Lens",
        "icon": "$(refresh)"
      },
      {
        "command": "linearLens.jumpToNextReference",
        "title": "Jump to Next Reference",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.jumpToPreviousReference",
        "title": "Jump to Previous Reference",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.revealInLinearView",
        "title": "Reveal in Linear View",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.copyIssueId",
        "title": "Copy Issue ID",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.revealFileRef",
        "title": "Reveal File Reference",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.checkoutBranch",
        "title": "Checkout Issue Branch",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.openBranchDiff",
        "title": "Open Issue Branch Diff",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.openInAgent",
        "title": "Open in Coding Agent",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.openInTool",
        "title": "Open in Coding Tool",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.openTicket",
        "title": "Open Issue Detail",
        "category": "Linear Lens",
        "icon": "$(preview)"
      },
      {
        "command": "linearLens.inlineComments.toggle",
        "title": "Toggle Inline Comments",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.copyIssueMarkdown",
        "title": "Copy as Markdown",
        "category": "Linear Lens",
        "icon": "$(markdown)"
      },
      {
        "command": "linearLens.createIssue",
        "title": "Create Issue…",
        "category": "Linear Lens",
        "icon": "$(add)"
      },
      {
        "command": "linearLens.openTeamBoard",
        "title": "Open Team Board",
        "category": "Linear Lens",
        "icon": "$(layout)"
      },
      {
        "command": "linearLens.openCycle",
        "title": "Open Active Cycle",
        "category": "Linear Lens",
        "icon": "$(history)"
      },
      {
        "command": "linearLens.editIssue",
        "title": "Edit Issue…",
        "category": "Linear Lens",
        "icon": "$(edit)"
      },
      {
        "command": "linearLens.setStatus",
        "title": "Set Status…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.setAssignee",
        "title": "Set Assignee…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.editLabels",
        "title": "Edit Labels…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.setTeam",
        "title": "Move to Team…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.setProject",
        "title": "Set Project…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.setPriority",
        "title": "Set Priority…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.setCycle",
        "title": "Set Cycle…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.editBlockers",
        "title": "Edit Blockers…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.addBlocker",
        "title": "Add Blocking Relation…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.addBlockedBy",
        "title": "Add Blocked-By Relation…",
        "category": "Linear Lens"
      },
      {
        "command": "linearLens.removeBlocker",
        "title": "Remove Blocker Relation…",
        "category": "Linear Lens"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "linearLens",
          "title": "Linear Lens",
          "icon": "media/linear.svg"
        }
      ]
    },
    "views": {
      "linearLens": [
        {
          "id": "linearLens.viewFile",
          "name": "Issues in This File"
        },
        {
          "id": "linearLens.viewMine",
          "name": "My Issues"
        },
        {
          "id": "linearLens.viewRecent",
          "name": "Assigned / Recent"
        },
        {
          "id": "linearLens.viewTeams",
          "name": "Teams",
          "when": "config.linearLens.teams.enable"
        },
        {
          "id": "linearLens.viewCycle",
          "name": "Active Cycle",
          "when": "config.linearLens.teams.enable"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "linearLens.revealFileRef",
          "when": "false"
        },
        {
          "command": "linearLens.checkoutBranch",
          "when": "false"
        },
        {
          "command": "linearLens.openBranchDiff",
          "when": "false"
        },
        {
          "command": "linearLens.openInAgent",
          "when": "false"
        },
        {
          "command": "linearLens.createIssue",
          "when": "config.linearLens.create.enable"
        },
        {
          "command": "linearLens.openTeamBoard",
          "when": "config.linearLens.board.enable"
        },
        {
          "command": "linearLens.openCycle",
          "when": "config.linearLens.teams.enable"
        },
        {
          "command": "linearLens.refreshTeams",
          "when": "config.linearLens.teams.enable"
        },
        {
          "command": "linearLens.editIssue",
          "when": "config.linearLens.edit.enable"
        },
        {
          "command": "linearLens.editBlockers",
          "when": "config.linearLens.edit.enable"
        },
        {
          "command": "linearLens.setStatus",
          "when": "false"
        },
        {
          "command": "linearLens.setAssignee",
          "when": "false"
        },
        {
          "command": "linearLens.editLabels",
          "when": "false"
        },
        {
          "command": "linearLens.setTeam",
          "when": "false"
        },
        {
          "command": "linearLens.setProject",
          "when": "false"
        },
        {
          "command": "linearLens.setPriority",
          "when": "false"
        },
        {
          "command": "linearLens.setCycle",
          "when": "false"
        },
        {
          "command": "linearLens.addBlocker",
          "when": "false"
        },
        {
          "command": "linearLens.addBlockedBy",
          "when": "false"
        },
        {
          "command": "linearLens.removeBlocker",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "linearLens.refreshViews",
          "when": "view == linearLens.viewFile || view == linearLens.viewMine || view == linearLens.viewRecent",
          "group": "navigation"
        },
        {
          "command": "linearLens.refreshTeams",
          "when": "view == linearLens.viewTeams || view == linearLens.viewCycle",
          "group": "navigation"
        },
        {
          "command": "linearLens.searchIssues",
          "when": "view == linearLens.viewMine || view == linearLens.viewRecent || view == linearLens.viewTeams",
          "group": "navigation"
        },
        {
          "command": "linearLens.createIssue",
          "when": "(view == linearLens.viewMine || view == linearLens.viewRecent || view == linearLens.viewTeams) && config.linearLens.create.enable",
          "group": "navigation"
        },
        {
          "command": "linearLens.openTeamBoard",
          "when": "view == linearLens.viewTeams && config.linearLens.board.enable",
          "group": "navigation"
        },
        {
          "command": "linearLens.openCycle",
          "when": "view == linearLens.viewCycle",
          "group": "navigation"
        },
        {
          "command": "linearLens.signIn",
          "when": "(view == linearLens.viewMine || view == linearLens.viewRecent || view == linearLens.viewTeams) && !linearLens.authed",
          "group": "1_auth"
        },
        {
          "command": "linearLens.signOut",
          "when": "(view == linearLens.viewMine || view == linearLens.viewRecent || view == linearLens.viewTeams) && linearLens.authed",
          "group": "1_auth"
        }
      ],
      "view/item/context": [
        {
          "command": "linearLens.openTeamBoard",
          "when": "viewItem == linearTeam && config.linearLens.board.enable",
          "group": "inline"
        },
        {
          "command": "linearLens.openTeamBoard",
          "when": "viewItem == linearTeam && config.linearLens.board.enable",
          "group": "1_team@1"
        },
        {
          "command": "linearLens.openCycle",
          "when": "viewItem == linearTeam",
          "group": "1_team@2"
        },
        {
          "command": "linearLens.openTicket",
          "when": "viewItem == linearIssue",
          "group": "inline"
        },
        {
          "command": "linearLens.openTicket",
          "when": "viewItem == linearIssue",
          "group": "1_open@1"
        },
        {
          "command": "linearLens.openIssue",
          "when": "viewItem == linearIssue",
          "group": "1_open@2"
        },
        {
          "command": "linearLens.copyIssueLink",
          "when": "viewItem == linearIssue",
          "group": "1_open@3"
        },
        {
          "command": "linearLens.copyIssueId",
          "when": "viewItem == linearIssue",
          "group": "1_open@4"
        },
        {
          "command": "linearLens.copyIssueMarkdown",
          "when": "viewItem == linearIssue",
          "group": "1_open@5"
        },
        {
          "command": "linearLens.checkoutBranch",
          "when": "viewItem == linearIssue",
          "group": "2_git@1"
        },
        {
          "command": "linearLens.openInTool",
          "when": "viewItem == linearIssue",
          "group": "2_git@2"
        },
        {
          "command": "linearLens.editIssue",
          "when": "viewItem == linearIssue && config.linearLens.edit.enable && linearLens.authed",
          "group": "3_edit@1"
        },
        {
          "command": "linearLens.editBlockers",
          "when": "viewItem == linearIssue && config.linearLens.edit.enable && linearLens.authed",
          "group": "3_edit@2"
        }
      ],
      "editor/context": [
        {
          "command": "linearLens.openTicket",
          "when": "editorTextFocus && linearLens.refUnderCursor",
          "group": "linearLens@1"
        },
        {
          "command": "linearLens.openIssue",
          "when": "editorTextFocus && linearLens.refUnderCursor",
          "group": "linearLens@2"
        },
        {
          "command": "linearLens.copyIssueLink",
          "when": "editorTextFocus && linearLens.refUnderCursor",
          "group": "linearLens@3"
        },
        {
          "command": "linearLens.copyIssueId",
          "when": "editorTextFocus && linearLens.refUnderCursor",
          "group": "linearLens@4"
        },
        {
          "command": "linearLens.revealInLinearView",
          "when": "editorTextFocus && linearLens.refUnderCursor",
          "group": "linearLens@5"
        },
        {
          "command": "linearLens.editIssue",
          "when": "editorTextFocus && linearLens.refUnderCursor && config.linearLens.edit.enable",
          "group": "linearLens@6"
        },
        {
          "command": "linearLens.copyIssueMarkdown",
          "when": "editorTextFocus && linearLens.refUnderCursor",
          "group": "linearLens@7"
        },
        {
          "command": "linearLens.editBlockers",
          "when": "editorTextFocus && linearLens.refUnderCursor && config.linearLens.edit.enable",
          "group": "linearLens@8"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "linearLens.viewMine",
        "contents": "Sign in to Linear to see issues assigned to you.\n[Sign in to Linear](command:linearLens.signIn)\nOr [set a personal API key](command:linearLens.setApiKey).",
        "when": "!linearLens.authed"
      },
      {
        "view": "linearLens.viewRecent",
        "contents": "Sign in to Linear to see recent issues.\n[Sign in to Linear](command:linearLens.signIn)",
        "when": "!linearLens.authed"
      },
      {
        "view": "linearLens.viewTeams",
        "contents": "Sign in to Linear to browse your teams and their issues.\n[Sign in to Linear](command:linearLens.signIn)\nOr [set a personal API key](command:linearLens.setApiKey).",
        "when": "!linearLens.authed"
      },
      {
        "view": "linearLens.viewCycle",
        "contents": "Sign in to Linear, then pick a team to view its active cycle.\n[Sign in to Linear](command:linearLens.signIn)",
        "when": "!linearLens.authed"
      },
      {
        "view": "linearLens.viewFile",
        "contents": "No Linear references found in the active file.\nOpen a file that mentions issues like ENG-123, or [configure your workspace slug](command:linearLens.configureWorkspace)."
      }
    ],
    "keybindings": [
      {
        "command": "linearLens.openIssue",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "linearLens.searchIssues",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "linearLens.jumpToNextReference",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]",
        "when": "editorTextFocus && linearLens.hasRefs"
      },
      {
        "command": "linearLens.jumpToPreviousReference",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+[",
        "when": "editorTextFocus && linearLens.hasRefs"
      },
      {
        "command": "linearLens.editIssue",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && linearLens.refUnderCursor && config.linearLens.edit.enable"
      }
    ],
    "configuration": {
      "title": "Linear Lens",
      "properties": {
        "linearLens.workspaceSlug": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your Linear workspace slug, used to build issue URLs like `https://linear.app/<slug>/issue/ENG-123`. Find it in your Linear URL."
        },
        "linearLens.teamKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Optional allowlist of team keys to recognize (e.g. `[\"ENG\", \"DESIGN\"]`). When empty, any `ABC-123`-shaped token (2–7 letters) is treated as an issue ID."
        },
        "linearLens.markers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "TODO",
            "FIXME",
            "BUG",
            "HACK"
          ],
          "markdownDescription": "Actionable marker keywords. A reference on a line containing one of these (or an unchecked `- [ ]` task) is treated as actionable and can appear in the Problems panel. Matched case-insensitively with word boundaries."
        },
        "linearLens.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Surface actionable, marker-bound Linear references in the Problems panel. Raw references in prose are never reported."
        },
        "linearLens.diagnostics.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "information",
          "description": "Severity used for marker-bound Linear references in the Problems panel."
        },
        "linearLens.links.enable": {
          "type": "boolean",
          "default": true,
          "description": "Turn recognized issue references into clickable document links."
        },
        "linearLens.hover.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show hover cards for issue references."
        },
        "linearLens.hover.showAvatars": {
          "type": "boolean",
          "default": true,
          "description": "Show stacked assignee and subscriber avatars in rich hovers. Falls back to a plain text name when the avatar URL is unavailable."
        },
        "linearLens.hover.showLabels": {
          "type": "boolean",
          "default": true,
          "description": "Show issue labels (with colored dots) in rich hovers."
        },
        "linearLens.hover.showBranchActions": {
          "type": "boolean",
          "default": true,
          "description": "Show the issue's suggested git branch name with Checkout and View Diff action links in rich hovers."
        },
        "linearLens.decorations.enable": {
          "type": "boolean",
          "default": true,
          "description": "Visibly highlight recognized issue references in the editor."
        },
        "linearLens.statusBar.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar item for the Linear issue detected in the current git branch."
        },
        "linearLens.api.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Fetch live issue metadata (title, status, assignee, priority, project) for richer hovers when signed in or a personal API key is set. Acts as a master kill-switch: when off, hovers stay basic even when authenticated."
        },
        "linearLens.cache.ttlSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "How long (in seconds) to cache fetched issue metadata before refetching."
        },
        "linearLens.cache.persist": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Persist fetched issue metadata to this workspace's storage so hovers, pills, and the rail stay instant across editor reloads (stale entries are refreshed in the background). Turn off to keep the cache in memory only."
        },
        "linearLens.inlineStatus.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show a small colored status indicator next to each issue reference, reflecting the live workflow state. Requires sign-in / a personal API key."
        },
        "linearLens.inlineStatus.style": {
          "type": "string",
          "enum": [
            "dot",
            "pill"
          ],
          "default": "dot",
          "description": "Inline status style: a colored dot or a labeled state pill."
        },
        "linearLens.gutter.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show a colored Linear workflow-state circle in the editor gutter beside each line containing an issue reference. Requires sign-in / a personal API key."
        },
        "linearLens.inlineComments.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show read-only Linear comment threads inline beside each issue reference, using the native Comments panel. Requires sign-in / a personal API key."
        },
        "linearLens.views.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show the Linear Activity Bar views (issues in this file, my issues, assigned / recent)."
        },
        "linearLens.views.recent.limit": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 100,
          "description": "How many issues to load in the My Issues / Assigned / Recent and search views."
        },
        "linearLens.agent.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional command id invoked by **Open in Coding Agent**. Leave empty to auto-detect a Cursor / VS Code agent command."
        },
        "linearLens.copyMarkdown.includeComments": {
          "type": "boolean",
          "default": false,
          "description": "Include the comment thread when copying a ticket as Markdown."
        },
        "linearLens.edit.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the issue-editing actions (Edit Issue, Edit Blockers, and the status/assignee/labels/team/project/priority/cycle sub-flows) in hovers, menus, and the issue detail view. Editing always re-checks for write access (a personal API key, or a write-capable Linear sign-in) and prompts when it is missing. Turn this off to hide all write actions."
        },
        "linearLens.create.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the **Create Issue** command (palette + view title-bar). Creating always re-checks for write access (a personal API key, or a write-capable Linear sign-in) and prompts when it is missing. Turn this off to hide the create action."
        },
        "linearLens.teams.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show the Teams and Active Cycle views in the Linear Lens sidebar."
        },
        "linearLens.teams.show": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Team KEYS to show in the Teams view (e.g. `[\"ENG\", \"DES\"]`). Empty = show all teams you can access (or just your teams when `#linearLens.teams.viewerOnly#` is on)."
        },
        "linearLens.teams.viewerOnly": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When `#linearLens.teams.show#` is empty, show only teams you are a member of (vs. every team in the workspace)."
        },
        "linearLens.teams.autoDetect": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically detect the signed-in workspace's real team keys and slug (`organization.urlKey`) from Linear and use them to recognize references — so only real issue ids (e.g. `ENG-123`) are highlighted/hovered/linked, and `#linearLens.workspaceSlug#` is no longer required to open issues. An explicit `#linearLens.teamKeys#` / `#linearLens.workspaceSlug#` always overrides detection. Turn off to rely solely on the configured values."
        },
        "linearLens.board.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the team Board webview (columns by workflow state, drag a card to change its status). Moving a card always re-checks for write access and prompts when it is missing."
        },
        "linearLens.view.defaultGroupBy": {
          "type": "string",
          "enum": [
            "none",
            "status",
            "assignee",
            "priority",
            "project",
            "label"
          ],
          "default": "none",
          "description": "Default grouping for the issue tree views (My Issues, Assigned / Recent, Teams)."
        },
        "linearLens.view.defaultSortBy": {
          "type": "string",
          "enum": [
            "updated",
            "priority",
            "status",
            "created",
            "title",
            "number"
          ],
          "default": "updated",
          "description": "Default sort for the issue tree views (My Issues, Assigned / Recent, Teams)."
        },
        "linearLens.debug": {
          "type": "boolean",
          "default": false,
          "description": "Emit verbose diagnostic output to the Linear Lens output channel. Useful when troubleshooting configuration or unexpected behavior."
        },
        "linearLens.worktree.filter": {
          "type": "string",
          "enum": [
            "off",
            "currentRepo",
            "currentWorktree"
          ],
          "enumDescriptions": [
            "No git-based filtering.",
            "Emphasize issues relevant to the current repository / branch.",
            "Emphasize issues relevant to the current worktree's checked-out branch."
          ],
          "default": "off",
          "markdownDescription": "How issue lists relate to your current git checkout. Emphasizes (sorts to top) matching issues rather than hiding others. `currentWorktree` is useful when you have multiple git worktrees open."
        },
        "linearLens.openIn.tool": {
          "type": "string",
          "enum": [
            "auto",
            "vscode",
            "cursor",
            "linear",
            "custom"
          ],
          "enumDescriptions": [
            "Auto-detect a coding agent (Cursor, Copilot Chat, etc.); open the issue URL when none is found.",
            "Use the detected VS Code agent command; open the issue URL as fallback.",
            "Use the detected Cursor agent command; open the issue URL as fallback.",
            "Always open the issue URL in the system browser.",
            "Run the command id set in `linearLens.openIn.customCommand`, passing `{ id, url }`."
          ],
          "default": "auto",
          "markdownDescription": "Where **Open in Coding Tool** opens an issue. `auto` detects an editor agent (Cursor / Copilot Chat); `linear` opens the issue URL; `custom` runs `#linearLens.openIn.customCommand#`."
        },
        "linearLens.openIn.customCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command id run by **Open in Coding Tool** when `#linearLens.openIn.tool#` is `custom`. The command receives `{ id, url }` where `id` is the normalized issue identifier and `url` is the canonical Linear URL."
        },
        "linearLens.write.confirmDestructive": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before destructive write actions (removing a blocker relation, moving an issue to another team). Turn off to proceed silently."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
